    },
    "display-l": {
      "$value": "600 31px/1.06 var(--font-display)",
      "$type": "typography"
    },
    "heading-l": {
      "$value": "600 25px/1.12 var(--font-display)",
      "$type": "typography"
    },
    "heading-m": {
      "$value": "700 19px/1.2 var(--font-learning)",
